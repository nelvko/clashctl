# clashctl 配置模板
# 日常配置请修改安装目录中的 .env，修改后重开终端生效。

# ===== 订阅下载 =====

# 连接超时（秒）
CLASHCTL_SUB_CONNECT_TIMEOUT=5

# 单次下载超时（秒）
CLASHCTL_SUB_TIMEOUT=20

# 下载失败重试次数
CLASHCTL_SUB_RETRY=2

# 下载请求的 User-Agent
CLASHCTL_SUB_UA=clash-verge/v2.4.0

# ===== 节点测速 =====

# 测速目标 URL
CLASHCTL_NODE_DELAY_URL=http://www.gstatic.com/generate_204

# 单节点测速超时（毫秒）
CLASHCTL_NODE_DELAY_TIMEOUT=5000

# 测速并发数（逐节点测速时使用）
CLASHCTL_NODE_DELAY_CONCURRENCY=8

# ===== 程序下载与更新 =====

# GitHub 下载代理前缀；空值为直连
GH_PROXY=

# 脚本更新分支
CLASHCTL_UPDATE_BRANCH=main

# 每次依赖下载尝试的最长时间（秒，默认 0 表示不限）
# 重试重新计时，连接或下载停滞时仍会中断并重试
CLASHCTL_DOWNLOAD_TIMEOUT=0

# 订阅转换器按需下载仓库；空值默认 asdlokj1qpi233/subconverter
SUBCONVERTER_REPO=

# ===== 自动生成（无需修改） =====

# 实际安装的内核
CLASHCTL_KERNEL=

# 服务管理方式（安装时自动检测）
INIT_TYPE=
